{
  "name": "atop26-smart",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "ATOP26-SMART",
  "author": "FPT Corporation",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build": "vite build",
    "build-storybook": "storybook build",
    "build:dev": "vite build",
    "build:prod": "vite build",
    "cap:sync": "npm run build && cap sync android",
    "cap:open:android": "cap open android",
    "cap:run:android": "npm run cap:sync && cap run android",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run --pool=threads --coverage --passWithNoTests || true",
    "test:watch": "vitest --pool=threads",
    "test:coverage": "vitest run --coverage --pool=threads --passWithNoTests || true",
    "test:coverage:een-add": "vitest run tests/features/een-add --pool=threads --coverage --coverage.all=false --coverage.include=\"src/features/een-add/**/*.{ts,vue}\"",
    "test:coverage:base-components": "vitest run --coverage --coverage.all=false --coverage.include=\"src/components/base/{breadcrumb,divider,slider,pagination,table-cell}/**/*.{ts,vue}\" tests/components/base/BaseBreadcrumb.spec.ts tests/components/base-divider.spec.ts tests/components/base-slider.spec.ts tests/components/base-pagination.spec.ts tests/components/base-table-cell.spec.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs,vue}": [
      "eslint --fix -c ./eslint.config.js"
    ],
    "*.{js,ts,vue,css,html,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@revolist/vue3-datagrid": "^4.28.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.19.0",
    "pinia": "^3.0.4",
    "vue": "3.5.22",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "9.39.1",
    "@quasar/app-vite": "2.4.0",
    "@quasar/quasar-app-extension-testing-unit-vitest": "1.2.4",
    "@quasar/vite-plugin": "1.12.0",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@types/node": "22.19.11",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.11",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vue": "10.8.0",
    "globals": "17.4.0",
    "happy-dom": "15.11.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "8.5.8",
    "prettier": "3.8.1",
    "storybook": "^10.5.10",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-checker": "0.10.3",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.1.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
